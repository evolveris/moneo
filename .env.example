# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, set the same names under Project > Settings > Environment Variables.

# Neon Postgres connection string (used from slice 02b). Use the dev branch
# locally; Vercel has the main branch (Production) and dev branch (Preview).
DATABASE_URL=

# Mode and limits (slice 04). Both are optional.
# APP_MODE=demo or user. Missing or anything else means demo.
APP_MODE=
# JSON keyed by visitor ID, e.g. {"visitor-id":{"maxRows":100}}
USER_LIMIT_OVERRIDES=
